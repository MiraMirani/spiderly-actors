{
  "actorSpecification": 1,
  "name": "linkedin-jobs-scraper-fast",
  "title": "LinkedIn Jobs Scraper - Fast, Multi-Keyword",
  "description": "Scrape public LinkedIn job listings by keyword, location and filters: full descriptions, seniority, applicants, company IDs and apply links. No login.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 1024,
    "timeoutSecs": 3600
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "jobs": {
          "title": "Jobs",
          "transformation": {
            "fields": [
              "title",
              "company",
              "location",
              "postedDate",
              "employmentType",
              "seniorityLevel",
              "applicants",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Title"
              },
              "company": {
                "label": "Company"
              },
              "location": {
                "label": "Location"
              },
              "postedDate": {
                "label": "Posted"
              },
              "employmentType": {
                "label": "Type"
              },
              "seniorityLevel": {
                "label": "Seniority"
              },
              "applicants": {
                "label": "Applicants"
              },
              "url": {
                "label": "Link",
                "format": "link"
              }
            }
          }
        }
      },
      "fields": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "companyUrl": {
            "type": "string"
          },
          "companyId": {
            "type": "string"
          },
          "companyLogo": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "postedDate": {
            "type": "string"
          },
          "postedAgo": {
            "type": "string"
          },
          "applicants": {
            "type": "string"
          },
          "seniorityLevel": {
            "type": "string"
          },
          "employmentType": {
            "type": "string"
          },
          "jobFunction": {
            "type": "string"
          },
          "industries": {
            "type": "string"
          },
          "salary": {
            "type": "string"
          },
          "applyType": {
            "type": "string"
          },
          "applyUrl": {
            "type": "string"
          },
          "salaryCurrency": {
            "type": "string"
          },
          "salaryPeriod": {
            "type": "string"
          },
          "posterFullName": {
            "type": "string"
          },
          "posterTitle": {
            "type": "string"
          },
          "posterProfileUrl": {
            "type": "string"
          },
          "posterPhoto": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "descriptionHtml": {
            "type": "string"
          },
          "searchKeywords": {
            "type": "string"
          },
          "searchLocation": {
            "type": "string"
          },
          "scrapedAt": {
            "type": "string"
          },
          "companyWebsite": {
            "type": "string"
          },
          "companyDescription": {
            "type": "string"
          },
          "companyIndustry": {
            "type": "string"
          },
          "companySize": {
            "type": "string"
          },
          "companyHeadquarters": {
            "type": "string"
          },
          "companyFounded": {
            "type": "string"
          },
          "salaryMin": {
            "type": [
              "number",
              "null"
            ]
          },
          "salaryMax": {
            "type": [
              "number",
              "null"
            ]
          },
          "companyFollowers": {
            "type": [
              "number",
              "null"
            ]
          },
          "companyEmployeesOnLinkedIn": {
            "type": [
              "number",
              "null"
            ]
          },
          "contactEmails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contactPhones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rank": {
            "type": "integer"
          },
          "detailsFailed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "meta": {
    "generatedBy": "Codex (GPT-6)"
  },
  "output": {
    "actorOutputSchemaVersion": 1,
    "title": "LinkedIn job results",
    "properties": {
      "jobs": {
        "type": "string",
        "title": "Jobs dataset",
        "description": "Collected public job listings and any available details.",
        "template": "{{links.apiDefaultDatasetUrl}}/items?format=json&clean=true"
      }
    }
  }
}
